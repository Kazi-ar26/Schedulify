/*
    ==================================================
                    Schedulify Global QSS
    ==================================================
*/


/* ==================================================
   GLOBAL
================================================== */

QWidget {

    font-family: "Segoe UI Variable", "Segoe UI", "Inter", sans-serif;

    font-size: 14px;

}


/* ==================================================
   LABELS
================================================== */

QLabel {

    background: transparent;

}

#dashboardTitle {

    font-size: 28px;

    font-weight: 700;

}


/* ==================================================
   BUTTONS
================================================== */

QPushButton {

    border: none;

    border-radius: 12px;

    padding: 10px 18px;

    font-size: 14px;

}

QPushButton:pressed {

    padding-top: 11px;

}


/* ==================================================
   INPUTS
================================================== */

QLineEdit,
QComboBox,
QSpinBox {

    border-radius: 12px;

    padding: 10px 12px;

    border-width: 1px;

    border-style: solid;

}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {

    border-width: 2px;

}


/* ==================================================
   LISTS
================================================== */

QListWidget {

    border-radius: 16px;

    padding: 8px;

}

QListWidget::item {

    padding: 10px;

    border-radius: 10px;

}

QListWidget::item:hover {

    background: rgba(255,255,255,0.06);

}


/* ==================================================
   CARDS
================================================== */

QFrame {

    border-radius: 16px;

}

QGroupBox {

    border-radius: 16px;

}

QGroupBox::title {

    subcontrol-origin: margin;

    left: 14px;

    padding: 0px 6px;

}


/* ==================================================
   SCROLLBAR
================================================== */

QScrollBar:vertical {

    width: 8px;

}

QScrollBar::handle:vertical {

    border-radius: 4px;

    min-height: 32px;

}


/* ==================================================
   SIDEBAR
================================================== */

QWidget#sidebar {

    min-width: 250px;

    max-width: 250px;

}


QLabel#sidebarLogo {

    padding-left: 12px;

    padding-top: 8px;

    padding-bottom: 28px;

}


QPushButton#sidebarButton,
QPushButton#sidebarUtilityButton {

    min-height: 46px;

    text-align: left;

    padding-left: 16px;

    padding-right: 16px;

    margin: 3px 6px;

    border-radius: 12px;

    font-size: 14px;

    font-weight: 500;

}


QPushButton#sidebarButton {

    icon-size: 20px;

}


QPushButton#sidebarUtilityButton {

    icon-size: 20px;

}


QPushButton#sidebarButton[active="true"] {

    font-weight: 600;

}


/* ==================================================
   NAVBAR
================================================== */

QWidget#navbar {

    min-height: 72px;

    max-height: 72px;

}


QLabel#navbarTitle {

    font-size: 24px;

    font-weight: 700;

    letter-spacing: 0.4px;

}


QLabel#navbarUser {

    font-size: 14px;

    font-weight: 600;

    padding: 8px 16px;

    border-radius: 18px;

}


QPushButton#navbarIconButton {

    min-width: 44px;

    max-width: 44px;

    min-height: 44px;

    max-height: 44px;

    border-radius: 22px;

    padding: 0px;

    icon-size: 20px;

}


/* ==================================================
   TOOLTIPS
================================================== */

QToolTip {

    border-radius: 8px;

    padding: 6px 10px;

    font-size: 13px;

}